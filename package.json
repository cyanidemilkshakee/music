{
  "name": "local-amp",
  "version": "1.0.0",
  "private": true,
  "description": "A local FFmpeg-backed music player with playlists and metadata extraction.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:rust": "cd backend && cargo run --release",
    "build:rust": "cd backend && cargo build --release",
    "dev:rust": "cd backend && cargo watch -x run",
    "test:rust": "cd backend && cargo test",
    "bench:rust": "cd backend && cargo bench",
    "lint:rust": "cd backend && cargo clippy -- -D warnings",
    "audit:rust": "cd backend && cargo deny check",
    "dev": "nodemon src/server.js",
    "build:glass": "esbuild public/react/liquid-glass-islands.jsx --bundle --format=esm --minify --outfile=public/generated/liquid-glass-islands.js",
    "test": "node scripts/check-backend.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "liquid-glass-react": "^1.1.1",
    "p-limit": "^7.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4"
  }
}
