{
  "name": "local-amp",
  "version": "1.0.0",
  "private": true,
  "description": "A local FFmpeg-backed music player with playlists and metadata extraction.",
  "scripts": {
    "start": "cd backend && cargo run --release",
    "build": "cd backend && cargo build --release",
    "dev": "cd backend && cargo watch -x run",
    "test": "cd backend && cargo test",
    "bench": "cd backend && cargo bench",
    "lint": "cd backend && cargo clippy -- -D warnings",
    "audit": "cd backend && cargo deny check"
  }
}
